<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-independent core (Assets/AfterZero/Scripts/Core) outside Unity
       with Unity's language level (C# 9) and runs the tests: `dotnet test unity/Tests` -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../AfterZero/Assets/AfterZero/Scripts/Core/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.4" />
  </ItemGroup>
</Project>
